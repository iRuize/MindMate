# 复制为 /opt/mindmate/mindmate.env，chmod 600
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 生产使用 PostgreSQL；本地开发仍默认连达梦
DB_URL=jdbc:postgresql://127.0.0.1:5432/mindmate
DB_USERNAME=mindmate
DB_PASSWORD=请替换为数据库密码

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

DEEPSEEK_API_KEY=请替换为真实密钥
DEEPSEEK_MODEL=deepseek-flash

MINDMATE_AVATAR_DIRECTORY=/opt/mindmate/uploads/avatars
MINDMATE_QUOTE_DIRECTORY=/opt/mindmate/uploads/quotes

# 关掉伪装短信回传，改用固定验证码登录；接入真实短信后清空 AUTH_FIXED_CODE
AUTH_EXPOSE_SMS_CODE=false
AUTH_FIXED_CODE=请替换为16位随机串

# 同源部署留空即可
CORS_ALLOWED_ORIGINS=
